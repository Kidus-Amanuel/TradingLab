# TradingLab Environment Configuration Template
# Copy this file to .env and adjust as needed. NEVER commit .env to version control.

# Runtime Mode
TRADINGLAB_ENVIRONMENT=development
TRADINGLAB_MODE=paper
TRADINGLAB_LIVE_ENABLED=false
TRADINGLAB_KILL_SWITCH_ACTIVE=false

# Account & Portfolio Defaults
TRADINGLAB_ACCOUNT_CURRENCY=USD
TRADINGLAB_PAPER_EQUITY=10000.00

# Mandatory Risk Limits (Never Relax)
TRADINGLAB_RISK_PER_TRADE_PCT=0.25
TRADINGLAB_MAX_DAILY_LOSS_PCT=2.0
TRADINGLAB_MAX_DRAWDOWN_PCT=10.0
TRADINGLAB_MAX_OPEN_POSITIONS=3

# Logging & Telemetry
TRADINGLAB_LOG_LEVEL=info
TRADINGLAB_LOG_FORMAT=json

# API Server
TRADINGLAB_API_HOST=127.0.0.1
TRADINGLAB_API_PORT=8000

# Exchange / Broker Sandbox Credentials (Leave blank until Phase 7)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET_KEY=
MT5_DEMO_LOGIN=
MT5_DEMO_PASSWORD=
MT5_DEMO_SERVER=
